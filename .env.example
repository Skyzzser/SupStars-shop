# Shared
NODE_ENV=development
BOT_TOKEN=123456:replace-with-real-token
WEB_APP_URL=http://localhost:3000
API_PUBLIC_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
ADMIN_IDS=123456789,987654321
ADMIN_USERNAMES=admin_username
SUPPORT_URL=https://t.me/SuupStarbot

# API
PORT=4000
DATABASE_URL=postgresql://suupstars:suupstars@localhost:5432/suupstars?schema=public
DEV_ALLOW_BROWSER=true
# In production, include every allowed Mini App origin, comma-separated.
# Example: https://your-mini-app.netlify.app,https://your-custom-domain.com
CORS_ORIGINS=
CRYPTOBOT_API_TOKEN=123456:replace-with-cryptopay-token
CRYPTOBOT_API_URL=https://pay.crypt.bot
CRYPTOBOT_WEBHOOK_SECRET=replace-with-random-crypto-webhook-secret
CRYPTOBOT_INVOICE_EXPIRES_IN=3600

# Bot
# Development can use polling. Production defaults to webhook and rejects polling.
BOT_MODE=polling
# Render Web Services inject PORT automatically; BOT_PORT is a local fallback.
BOT_PORT=4010
# Render bot Web Service public HTTPS URL, without a trailing path.
BOT_PUBLIC_URL=https://your-bot-service.onrender.com
BOT_WEBHOOK_PATH=/telegram/webhook
# Optional override. If set, it must be the full public HTTPS webhook URL.
BOT_WEBHOOK_URL=
BOT_WEBHOOK_SECRET=replace-with-random-secret

# Web / Mini App
# Local: http://localhost:4000
# Production: public HTTPS API URL, never localhost.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_DEV_TELEGRAM_ID=123456789
NEXT_PUBLIC_DEV_USERNAME=dev_admin
MANUAL_WALLET_ENABLED=true
MANUAL_WALLET_NETWORK=TON
MANUAL_WALLET_ASSET=USDT
MANUAL_WALLET_ADDRESS=replace-with-wallet-address
MANUAL_WALLET_MEMO=
MANUAL_WALLET_INSTRUCTIONS=Отправьте точную сумму и нажмите Я оплатил после перевода.
