{
  "name": "suup-stars-store",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "pnpm --filter @suupstars/shared build && pnpm --parallel --filter @suupstars/api --filter @suupstars/bot --filter @suupstars/web dev",
    "dev:api": "pnpm --filter @suupstars/shared build && pnpm --filter @suupstars/api dev",
    "dev:bot": "pnpm --filter @suupstars/shared build && pnpm --filter @suupstars/bot dev",
    "dev:web": "pnpm --filter @suupstars/shared build && pnpm --filter @suupstars/web dev",
    "build": "pnpm -r build",
    "install:render:api": "pnpm --filter @suupstars/api... install --frozen-lockfile --prod=false",
    "build:render:api": "pnpm run install:render:api && pnpm --filter @suupstars/api... build",
    "build:netlify": "pnpm --filter @suupstars/web... build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "format": "prettier --write .",
    "db:generate": "pnpm --filter @suupstars/api prisma:generate",
    "db:migrate": "pnpm --filter @suupstars/api prisma:migrate",
    "db:seed": "pnpm --filter @suupstars/api prisma:seed"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3"
  }
}
