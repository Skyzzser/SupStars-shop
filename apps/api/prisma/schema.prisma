generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductType {
  stars
  premium
}

enum OrderStatus {
  pending
  awaiting_payment
  paid
  processing
  completed
  failed
  cancelled
  refunded
}

model User {
  id          String   @id @default(cuid())
  telegramId BigInt   @unique
  username    String?
  firstName   String?
  lastName    String?
  language    String?
  isAdmin     Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  orders       Order[]
  adminActions AdminAction[] @relation("AdminActor")

  @@index([username])
}

model Product {
  id          String      @id @default(cuid())
  type        ProductType @unique
  title       String
  description String
  minQuantity Int?
  priceRub    Decimal     @db.Decimal(12, 2)
  priceUsd    Decimal     @db.Decimal(12, 4)
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  items OrderItem[]
}

model Order {
  id                String      @id @default(cuid())
  orderNumber       String      @unique
  userId            String
  user              User        @relation(fields: [userId], references: [id])
  status            OrderStatus @default(pending)
  recipientUsername String
  comment           String?
  internalNote      String?
  totalRub          Decimal     @db.Decimal(12, 2)
  totalUsd          Decimal     @db.Decimal(12, 2)
  idempotencyKey    String      @unique
  providerName      String?
  providerPayload   Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  items         OrderItem[]
  payments      Payment[]
  statusHistory OrderStatusHistory[]
  adminActions  AdminAction[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model OrderItem {
  id          String      @id @default(cuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String
  product     Product     @relation(fields: [productId], references: [id])
  productType ProductType
  title       String
  quantity    Int
  unitRub     Decimal     @db.Decimal(12, 2)
  unitUsd     Decimal     @db.Decimal(12, 4)
  totalRub    Decimal     @db.Decimal(12, 2)
  totalUsd    Decimal     @db.Decimal(12, 2)
  createdAt   DateTime    @default(now())
}

model Payment {
  id                String   @id @default(cuid())
  orderId           String
  order             Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider          String
  providerPaymentId String?
  status            String
  amountRub         Decimal  @db.Decimal(12, 2)
  amountUsd         Decimal  @db.Decimal(12, 2)
  payload           Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([provider, providerPaymentId])
}

model OrderStatusHistory {
  id              String      @id @default(cuid())
  orderId         String
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status          OrderStatus
  note            String?
  actorTelegramId BigInt?
  createdAt       DateTime    @default(now())

  @@index([orderId, createdAt])
}

model AdminAction {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation("AdminActor", fields: [adminId], references: [id])
  action    String
  note      String?
  createdAt DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([orderId, createdAt])
}
